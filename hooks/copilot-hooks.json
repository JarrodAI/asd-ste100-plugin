{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/activate.js\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\activate.js\"",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/toggle.js\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\toggle.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
